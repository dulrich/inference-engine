[Unit]
Description=codex app-server sidecar (Anthropic Messages front end for codex personas)
# No After= line on purpose. `network.target` is LoadState=not-found in the systemd *user*
# manager (it orders against nothing), and a user unit cannot order after a system unit such
# as docker.service. The docker0 bind race is handled in-process instead: the sidecar retries
# the extra bind and reports /healthz degraded until it lands. Do not re-add an ordering line.
@FLEET_ENV_UNIT@

[Service]
Type=simple
ExecStart=@EXEC@
Environment=PATH=@PATH@
Environment=SIDECAR_PERSONAS=@PERSONAS@
EnvironmentFile=@ENV_FILE@
StandardInput=null
Restart=on-failure
RestartSec=5

# Hardening: networked baseline sandbox block; relaxations are commented inline.
# Writes: the persona CODEX_HOMEs (children refresh OAuth, sqlite, logs) and the sidecar
# log/state dirs. Reads %t/fleet-env (EnvironmentFile) and ~/.local/lib/codex (codex release).
# MemoryDenyWriteExecute is omitted on purpose: the codex children are unmeasured for a JIT.
# PrivateTmp is kept; the sidecar and its children use no shared /tmp state.
# codex bwrap sandbox (codex-cli 0.166; turns run "sandbox": "read-only" and unified_exec is
# catalog-pinned on) needs: user+mnt+pid+ipc+net namespaces, @mount + seccomp + capset/pivot_root
# (so ~@privileged is narrowed to its non-bwrap members), and AF_NETLINK (bwrap loopback setup).
# Measured 2026-11-02 with `codex sandbox -- /bin/echo ok` under these exact properties.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@RW_PATHS@ %h/.local/state/codex-sidecar
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=user mnt pid ipc net
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service @mount seccomp
SystemCallFilter=~@resources @clock @cpu-emulation @debug @module @obsolete @raw-io @reboot @swap bpf chroot setuid setresuid setgroups
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=default.target
