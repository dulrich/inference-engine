+  get isDisabled(): boolean {
+    return this.disabled;
+  }
+
+  /** Queue one record. Never throws; never blocks the caller on I/O. */
+  write(record: Record<string, unknown>, logger?: TelemetryLogger): void {
+    if (this.disabled) {
+      return;
+    }
+    if (!this.ensureUsableDirectory(logger)) {
+      return;
+    }
+
+    let line: string;
+    try {
+      line = `${JSON.stringify(record)}\n`;
+    } catch {
+      return;
+    }
