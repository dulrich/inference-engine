+  // "All target providers failed." envelope. Every other case (other source protocols,
+  // non-final attempts, empty bodies, dispatch-stage failures) keeps the envelope unchanged.
+  it('relays the final Anthropic-protocol attempt upstream error body byte-verbatim (patch 0003)', async () => {
+    const rawErrorBody = '{"type":"error","error":{"type":"invalid_request_error","message":"WP2-SENTINEL"}}';
+    const fetchMock = vi.fn(async () =>
