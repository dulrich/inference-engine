{
  "name": "bench-dashboard",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter '@bench-dashboard/api' dev & bun run --filter '@bench-dashboard/web' dev",
    "dev:api": "bun run --filter '@bench-dashboard/api' dev",
    "dev:web": "bun run --filter '@bench-dashboard/web' dev",
    "build": "bun run --filter '@bench-dashboard/web' build && bun run --filter '@bench-dashboard/api' build",
    "start": "bun run --filter '@bench-dashboard/api' start",
    "ingest": "bun run --filter '@bench-dashboard/api' ingest",
    "smoke": "bun run --filter '@bench-dashboard/api' smoke",
    "test": "bun test apps packages",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p packages/shared/tsconfig.json && tsc -p apps/api/tsconfig.json && bun run --filter '@bench-dashboard/web' check",
    "test:theme": "bun <code-root>/fleet-tools/scripts/check-contrast.mjs --signalworks packages/signalworks/css apps/web/src",
    "design:verify": "bash <code-root>/fleet-tools/signalworks/install.sh --verify --dest .",
    "test:security": "trivy fs --scanners vuln,misconfig --skip-db-update --skip-check-update --exit-code 1 --severity CRITICAL,HIGH ."
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/bun": "^1.3.14",
    "eslint": "^9.0.0",
    "eslint-plugin-svelte": "^3.0.0",
    "globals": "^15.0.0",
    "jiti": "^2.0.0",
    "svelte-check": "^4.0.0",
    "svelte-eslint-parser": "^1.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
