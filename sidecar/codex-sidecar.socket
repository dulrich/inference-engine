[Unit]
Description=codex-sidecar listen socket (loopback; held for every codex-sidecar@ generation)
# The socket owns 127.0.0.1:4877 for the life of the user manager. Generations
# (codex-sidecar@<activation>.service) inherit it through Sockets=; Service= names the hold
# unit, so traffic never activates a generation: with none running, connections queue.

[Socket]
ListenStream=127.0.0.1:4877
Service=codex-sidecar-hold.service

[Install]
WantedBy=sockets.target
