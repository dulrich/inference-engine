+// Patch 0003 (upstream-error-body-passthrough): decided at the non-2xx response site, with a
+// Response clone taken before any read (audit B2 — the attempt record's parsed payload is not
+// byte-verbatim and cannot distinguish an empty body). Scoped to Anthropic-protocol sources on
+// their final target attempt with a non-empty raw body (audit M2 — every other source protocol,
+// non-final attempt, or empty body keeps the existing envelope, unchanged).
+async function maybeRelayRawUpstreamErrorResponse(
+  reply: FastifyReply,
+  source: GatewaySourceContext,
+  rawUpstreamResponse: Response
+): Promise<boolean> {
+  if (source.adapterKey !== 'anthropic_messages') {
+    return false;
+  }
+
+  const rawBody = Buffer.from(await rawUpstreamResponse.arrayBuffer());
+  if (rawBody.byteLength === 0) {
+    return false;
+  }
+
+  reply.code(rawUpstreamResponse.status);
+  const contentType = rawUpstreamResponse.headers.get('content-type');
+  if (contentType) {
+    reply.header('content-type', contentType);
+  }
+  reply.send(rawBody);
+  return true;
+}
