diff --git a/src/gateway/request-telemetry.test.ts b/src/gateway/request-telemetry.test.ts
new file mode 100644
index 0000000..987d9e0
--- /dev/null
+++ b/src/gateway/request-telemetry.test.ts
@@ -0,0 +1,443 @@
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+
+import {
+  beginRequestTelemetry,
+  finishRequestTelemetry,
+  noteRequestTelemetryAttempt,
+  noteRequestTelemetryFailure,
+  noteRequestTelemetryUsage,
+  readClaudeCodeSessionId,
+  readSubagentWitness,
+  resolveTelemetryOptionsFromEnv,
+  setRequestTelemetrySinkForTests,
+  TelemetrySink,
+  noteRequestTelemetryStreamText,
+  tapUpstreamStreamForTelemetry
+} from './request-telemetry';
+
+/**
+ * Patch 0006 (request-telemetry-jsonl). The sink is the router's only per-request record, and
+ * the one thing it must never do is leak a credential or a prompt into a file a dashboard
+ * tails, so redaction is asserted against a request that carries a bearer, the gateway key
+ * header and real message text at once.
+ */
+
+const BEARER = 'sk-ant-oat01-TESTBEARER-DO-NOT-LOG';
+const GATEWAY_KEY = 'GATEWAYKEY-TESTVALUE-DO-NOT-LOG';
+const MESSAGE_TEXT = 'the capital of assyria is a secret prompt string';
+const SYSTEM_TEXT = 'You are Claude Code. cc_is_subagent=true; billing line';
+const SESSION_ID = '7f3c1e88-9d21-4a6b-bb0f-2c5d9e410000';
+
+let dir: string;
+
+function makeSink(overrides: Partial<{ maxBytes: number; keepFiles: number }> = {}) {
+  return new TelemetrySink({
+    dir,
+    maxBytes: overrides.maxBytes ?? 1024 * 1024,
+    keepFiles: overrides.keepFiles ?? 14
+  });
+}
+
+function makeRequest(): { request: unknown; reply: unknown; close: () => void } {
+  const closeHandlers: Array<() => void> = [];
+  const request = {
+    id: 'req-telemetry-1',
+    url: '/v1/messages?beta=true',
+    method: 'POST',
+    headers: {
+      authorization: `Bearer ${BEARER}`,
+      'x-gateway-key': GATEWAY_KEY,
+      'content-type': 'application/json'
+    },
+    log: { warn: vi.fn(), info: vi.fn() }
+  };
+  const reply = {
+    raw: {
+      statusCode: 200,
+      on: (event: string, handler: () => void) => {
+        if (event === 'close') {
+          closeHandlers.push(handler);
+        }
+      }
+    }
+  };
+  return {
+    request,
+    reply,
+    close: () => closeHandlers.forEach((handler) => handler())
+  };
+}
+
+function makeBody(): Record<string, unknown> {
+  return {
+    model: 'claude-local/qwen36-a3b',
+    stream: true,
+    metadata: { user_id: `user_abc123hash_account_11112222-3333-4444-5555-666677778888_session_${SESSION_ID}` },
+    system: [{ type: 'text', text: SYSTEM_TEXT }],
+    messages: [{ role: 'user', content: [{ type: 'text', text: MESSAGE_TEXT }] }]
+  };
+}
+
+function readLines(): Array<Record<string, unknown>> {
+  const files = fs
+    .readdirSync(dir)
+    .filter((name) => name.endsWith('.jsonl'))
+    .sort();
+  return files.flatMap((name) =>
+    fs
+      .readFileSync(path.join(dir, name), 'utf8')
+      .split('\n')
+      .filter((line) => line.trim())
+      .map((line) => JSON.parse(line) as Record<string, unknown>)
+  );
+}
+
+function readRawText(): string {
+  return fs
+    .readdirSync(dir)
+    .filter((name) => name.endsWith('.jsonl'))
+    .sort()
+    .map((name) => fs.readFileSync(path.join(dir, name), 'utf8'))
+    .join('');
+}
+
+beforeEach(() => {
+  dir = fs.mkdtempSync(path.join(os.tmpdir(), 'router-telemetry-'));
+});
+
+afterEach(() => {
+  vi.useRealTimers();
+  setRequestTelemetrySinkForTests(undefined);
+  fs.rmSync(dir, { recursive: true, force: true });
+});
+
+describe('request telemetry record', () => {
+  it('writes one terminal request record carrying the pinned fields', async () => {
+    const sink = makeSink();
+    setRequestTelemetrySinkForTests(sink);
+    const { request, reply } = makeRequest();
+
+    beginRequestTelemetry(request as never, reply as never, 'anthropic_messages', makeBody(), true);
+    noteRequestTelemetryAttempt(request, {
+      provider: 'openai',
+      providerName: 'claude-local',
+      sourceAdapterKey: 'anthropic_messages',
+      upstreamUrl: 'http://inference-engine-llama:4806/v1/chat/completions',
+      model: 'qwen36-a3b'
+    });
+    noteRequestTelemetryStreamText(
+      request,
+      'data: {"model":"qwen36-a3b","choices":[{"delta":{"content":"hi"}}]}\n\n',
+      'openai_chunks'
+    );
+    noteRequestTelemetryStreamText(
+      request,
+      'data: {"choices":[{"delta":{},"finish_reason":"stop"}],"timings":{"prompt_n":17,"prompt_ms":42.5,"predicted_n":40,"predicted_ms":900.25,"predicted_per_second":44.4}}\n\ndata: [DONE]\n\n',
+      'openai_chunks'
+    );
+    // The engine's billing model on the local leg is llama-server's absolute gguf path; it must
+    // not clobber the joinable id the resolved target/upstream chunk already supplied.
+    noteRequestTelemetryUsage(
+      request,
+      { input: 17, output: 40, cacheRead: 13, cacheWrite: 0 },
+      '/models/unsloth/Qwen3.6-35B-A3B-MTP-GGUF/Qwen3.6-35B-A3B-UD-Q4_K_XL.gguf'
+    );
+    finishRequestTelemetry(request);
+    await sink.flush();
+
+    const lines = readLines();
+    expect(lines).toHaveLength(1);
+    const record = lines[0] as Record<string, unknown>;
+    expect(record).toMatchObject({
+      kind: 'request',
+      reqId: 'req-telemetry-1',
+      route: '/v1/messages',
+      method: 'POST',
+      sourceAdapterKey: 'anthropic_messages',
+      leg: 'claude-local',
+      providerType: 'openai',
+      upstreamUrl: 'http://inference-engine-llama:4806/v1/chat/completions',
+      sessionId: SESSION_ID,
+      isSubagent: true,
+      modelRequested: 'claude-local/qwen36-a3b',
+      modelResolved: 'qwen36-a3b',
+      stream: true,
+      status: 200,
+      attemptSequence: 1,
+      stopReason: 'stop',
+      error: null
+    });
+    expect(record.usage).toEqual({ input: 17, output: 40, cacheRead: 13, cacheWrite: 0 });
+    // The llama-server timings object, read off the upstream chunk before the conversion drops it.
+    expect(record.upstreamTimings).toEqual({
+      prompt_n: 17,
+      prompt_ms: 42.5,
+      predicted_n: 40,
+      predicted_ms: 900.25,
+      predicted_per_second: 44.4
+    });
+    expect(typeof record.ts).toBe('string');
+    expect(typeof record.wallMs).toBe('number');
+    expect(record.ttftMs).toBeTypeOf('number');
+    expect(record.responseTokens).toBe(1);
+  });
+
+  it('never writes the bearer, the gateway key, the system text or message content', async () => {
+    const sink = makeSink();
+    setRequestTelemetrySinkForTests(sink);
+    const { request, reply } = makeRequest();
+
+    beginRequestTelemetry(request as never, reply as never, 'anthropic_messages', makeBody(), true);
+    noteRequestTelemetryAttempt(request, {
+      provider: 'openai',
+      providerName: 'claude-local',
+      sourceAdapterKey: 'anthropic_messages',
+      upstreamUrl: 'http://inference-engine-llama:4806/v1/chat/completions'
+    });
+    noteRequestTelemetryStreamText(
+      request,
+      `data: {"choices":[{"delta":{"content":"${MESSAGE_TEXT}"}}]}\n\n`,
+      'openai_chunks'
+    );
+    finishRequestTelemetry(request);
+    await sink.flush();
+
+    const raw = readRawText();
+    expect(raw.length).toBeGreaterThan(0);
+    expect(raw).not.toContain(BEARER);
+    expect(raw).not.toContain(GATEWAY_KEY);
+    expect(raw).not.toContain('Bearer ');
+    expect(raw).not.toContain(MESSAGE_TEXT);
+    expect(raw).not.toContain(SYSTEM_TEXT);
+    expect(raw).not.toContain('authorization');
+    expect(raw).not.toContain('x-gateway-key');
+    // The account/user segments of metadata.user_id are identity material: only the session
+    // segment is ever extracted.
+    expect(raw).not.toContain('user_abc123hash_account_');
+    expect(raw).toContain(SESSION_ID);
+  });
+
+  it('records the failing stage from the attempts envelope', async () => {
+    const sink = makeSink();
+    setRequestTelemetrySinkForTests(sink);
+    const { request, reply } = makeRequest();
+    (reply as { raw: { statusCode: number } }).raw.statusCode = 400;
+
+    beginRequestTelemetry(request as never, reply as never, 'anthropic_messages', makeBody(), false);
+    noteRequestTelemetryFailure(request, 'model_resolution', 'Model is not allowed for provider.');
+    finishRequestTelemetry(request);
+    await sink.flush();
+
+    const record = readLines()[0] as Record<string, unknown>;
+    expect(record.status).toBe(400);
+    expect(record.error).toEqual({
+      stage: 'model_resolution',
+      message: 'Model is not allowed for provider.'
+    });
+  });
+});
+
+describe('progress records', () => {
+  it('emits at most one progress line per interval and the terminal record last', async () => {
+    vi.useFakeTimers();
+    const sink = makeSink();
+    setRequestTelemetrySinkForTests(sink);
+    const { request, reply } = makeRequest();
+
+    beginRequestTelemetry(request as never, reply as never, 'anthropic_messages', makeBody(), true);
+    noteRequestTelemetryAttempt(request, { provider: 'openai', providerName: 'claude-local' });
+
+    const upstream = new Response(
+      new ReadableStream<Uint8Array>({
+        start(controller) {
+          controller.enqueue(new TextEncoder().encode('data: {"choices":[{"delta":{}}]}\n\n'));
+        }
+      }),
+      { status: 200 }
+    );
+    // Opening the tap starts the progress cadence; the stream is deliberately left open.
+    tapUpstreamStreamForTelemetry(request, upstream, 'openai_chunks');
+
+    vi.advanceTimersByTime(3500);
+    noteRequestTelemetryStreamText(
+      request,
+      'data: {"choices":[{"delta":{"content":"a"}}]}\n\n',
+      'openai_chunks'
+    );
+    vi.advanceTimersByTime(1000);
+    finishRequestTelemetry(request);
+    vi.advanceTimersByTime(5000);
+    await sink.flush();
+
+    const lines = readLines();
+    const progress = lines.filter((line) => line.kind === 'progress');
+    const terminal = lines.filter((line) => line.kind === 'request');
+    // 3500 ms then 1000 ms at a 1000 ms cadence: four ticks, never one per chunk.
+    expect(progress).toHaveLength(4);
+    expect(terminal).toHaveLength(1);
+    expect(lines[lines.length - 1]?.kind).toBe('request');
+    expect(progress[0]).toMatchObject({
+      kind: 'progress',
+      reqId: 'req-telemetry-1',
+      sessionId: SESSION_ID,
+      leg: 'claude-local',
+      phase: 'prefill',
+      responseTokens: 0
+    });
+    expect(progress[progress.length - 1]).toMatchObject({ phase: 'decode', responseTokens: 1 });
+    for (const line of progress) {
+      expect(typeof line.elapsedMs).toBe('number');
+    }
+  });
+
+  it('does not emit a second terminal record for the same request', async () => {
+    const sink = makeSink();
+    setRequestTelemetrySinkForTests(sink);
+    const { request, reply } = makeRequest();
+
+    beginRequestTelemetry(request as never, reply as never, 'anthropic_messages', makeBody(), false);
+    finishRequestTelemetry(request);
+    finishRequestTelemetry(request);
+    await sink.flush();
+
+    expect(readLines().filter((line) => line.kind === 'request')).toHaveLength(1);
+  });
+});
+
+describe('stream tap', () => {
+  it('relays the upstream bytes unchanged while reading model, stop reason and usage', async () => {
+    const sink = makeSink();
+    setRequestTelemetrySinkForTests(sink);
+    const { request, reply } = makeRequest();
+
+    beginRequestTelemetry(request as never, reply as never, 'anthropic_messages', makeBody(), true);
+    const frames = [
+      'event: message_start\ndata: {"type":"message_start","message":{"model":"claude-sonnet-4-6","usage":{"input_tokens":32,"cache_read_input_tokens":189434}}}\n\n',
+      'event: content_block_delta\ndata: {"type":"content_block_delta","delta":{"type":"thinking_delta","thinking":"hmm"}}\n\n',
+      'event: content_block_delta\ndata: {"type":"content_block_delta","delta":{"type":"text_delta","text":"hello"}}\n\n',
+      'event: message_delta\ndata: {"type":"message_delta","delta":{"stop_reason":"end_turn"},"usage":{"output_tokens":1865}}\n\n'
+    ];
+    const upstream = new Response(
+      new ReadableStream<Uint8Array>({
+        start(controller) {
+          for (const frame of frames) {
+            controller.enqueue(new TextEncoder().encode(frame));
+          }
+          controller.close();
+        }
+      }),
+      { status: 200, headers: { 'content-type': 'text/event-stream' } }
+    );
+
+    const tapped = tapUpstreamStreamForTelemetry(request, upstream, 'anthropic_events');
+    expect(tapped.status).toBe(200);
+    expect(tapped.headers.get('content-type')).toBe('text/event-stream');
+    expect(await tapped.text()).toBe(frames.join(''));
+
+    finishRequestTelemetry(request);
+    await sink.flush();
+
+    const record = readLines().find((line) => line.kind === 'request') as Record<string, unknown>;
+    expect(record).toMatchObject({
+      modelResolved: 'claude-sonnet-4-6',
+      stopReason: 'end_turn',
+      responseTokens: 1,
+      reasoningTokens: 1
+    });
+    expect(record.usage).toMatchObject({ input: 32, output: 1865, cacheRead: 189434 });
+    expect(record.ttftMs).toBeTypeOf('number');
+  });
+});
+
+describe('sink bounding', () => {
+  it('rotates by size into router-YYYY-MM-DD.N.jsonl and keeps at most keepFiles files', async () => {
+    const sink = makeSink({ maxBytes: 1024, keepFiles: 2 });
+    for (let index = 0; index < 40; index += 1) {
+      sink.write({ kind: 'request', reqId: `req-${index}`, filler: 'x'.repeat(200) });
+      await sink.flush();
+    }
+
+    const files = fs.readdirSync(dir).sort();
+    expect(files.length).toBe(2);
+    for (const name of files) {
+      expect(name).toMatch(/^router-\d{4}-\d{2}-\d{2}\.\d+\.jsonl$/);
+      expect(fs.statSync(path.join(dir, name)).size).toBeLessThanOrEqual(1024 + 256);
+    }
+    // Newest kept: the final record is still readable, and every kept line is whole JSON.
+    const lines = readRawText().split('\n').filter((line) => line.trim());
+    expect(lines.every((line) => JSON.parse(line) !== null)).toBe(true);
+    expect(lines[lines.length - 1]).toContain('"req-39"');
+  });
+
+  it('flushes whole lines only, so a tailing reader never sees a partial record', async () => {
+    const sink = makeSink();
+    for (let index = 0; index < 500; index += 1) {
+      sink.write({ kind: 'progress', reqId: `req-${index}`, filler: 'y'.repeat(300) });
+    }
+    await sink.flush();
+    const raw = readRawText();
+    expect(raw.endsWith('\n')).toBe(true);
+    for (const line of raw.split('\n').filter((entry) => entry.trim())) {
+      expect(() => JSON.parse(line)).not.toThrow();
+    }
+  });
+
+  it('disables itself with a single warning when the sink directory is not writable', () => {
