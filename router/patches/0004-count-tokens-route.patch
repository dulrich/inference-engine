+// Patch 0004 (count-tokens-route, audit B3/M1/E1): a lean proxy for
+// POST /v1/messages/count_tokens. Reuses the same ordered target-provider + target-model
+// resolution `handleGatewayRequest` uses for `/v1/messages` (resolveTargetProviders +
+// resolveTargetModel, with the model-validation fallthrough across the ordered default
+// provider list — never a reimplemented bare-id shortcut) and the same credential path
+// (buildAnthropicHeaders for the base headers, applyProviderCredentials for the local
+// leg's provider-apikey replacement, gated the same way applyProviderRequestOverrides
+// gates it: only when the target route carries an explicit providerConfig). URL
+// construction is provider-specific (audit B3): the local baseurl already ends in `/v1`,
+// so the `/v1` segment is appended only when the resolved baseurl doesn't already carry
+// one. Upstream status/body are relayed verbatim (including errors), consistent with
+// patch 0003's error-passthrough contract.
+export async function handleAnthropicCountTokensRequest(
+  request: FastifyRequest,
+  reply: FastifyReply,
+  config: GatewayConfig,
+  runtime: GatewayRuntime
+) {
+  const clientAbortSignal = createClientDisconnectSignal(request, reply);
+  const source: GatewaySourceContext = { adapterKey: 'anthropic_messages' };
+  const sourceAdapter = runtime.sourceAdapters.get(source.adapterKey);
+  if (!sourceAdapter) {
+    return reply.code(500).send({
+      error: {
+        message: `Source adapter is not registered: ${source.adapterKey}`
+      }
+    });
+  }
+
+  const body = request.body;
+  if (!isObject(body)) {
+    return sendBadRequest(reply, 'Request body must be a JSON object.');
+  }
+
+  const requestedModel =
+    readHeader(request.headers['x-target-model']) || resolvePassthroughModel(body, source);
+
+  const targetProvidersResult = resolveTargetProviders(
+    request,
+    sourceAdapter.provider,
+    config,
+    requestedModel
+  );
+  if (!targetProvidersResult.ok) {
+    return sendBadRequest(reply, targetProvidersResult.error);
+  }
+
+  let resolvedTarget: TargetProviderRoute | undefined;
+  let resolvedProviderConfig: ProviderConfig | undefined;
+  let resolvedModel: string | undefined;
+
+  for (const target of targetProvidersResult.value) {
+    const targetProviderConfig = resolveProviderConfig(config, target);
+    const modelResult = resolveTargetModel(request, target, requestedModel, config);
+    if (!modelResult.ok || !modelResult.value) {
+      continue;
+    }
+
+    resolvedTarget = target;
+    resolvedProviderConfig = targetProviderConfig;
+    resolvedModel = modelResult.value;
+    break;
+  }
+
+  if (!resolvedTarget || !resolvedModel) {
+    return reply.code(404).send({
+      error: {
+        message: `Model not found for /v1/messages/count_tokens: ${requestedModel || '(none)'}`,
+        type: 'invalid_request_error',
+        code: 'model_not_found'
+      }
+    });
+  }
+
+  if (clientAbortSignal.aborted) {
+    return;
+  }
+
+  // An explicit local providerConfig with its own apikey (e.g. claude-local) replaces whatever
+  // credential buildAnthropicHeaders would otherwise resolve, exactly like
+  // applyProviderRequestOverrides's unconditional override for an explicit provider route
+  // (router/AGENTS.md "Config" — claude-local's apikey is a load-bearing dummy). In that case a
+  // missing incoming/managed Anthropic credential must not fail the request: the local leg
+  // never needed a real one.
+  const hasExplicitProviderConfig = Boolean(resolvedTarget.providerConfig);
+  const willOverrideCredential = hasExplicitProviderConfig && Boolean(resolvedProviderConfig?.apikey);
+
+  let upstreamHeaders: Record<string, string>;
+  if (willOverrideCredential) {
+    upstreamHeaders = buildCountTokensLocalPassthroughHeaders(request.headers);
+  } else {
+    const headersResult = buildAnthropicHeaders(request.headers, config);
+    if (!headersResult.ok) {
+      return sendBadRequest(reply, headersResult.error);
+    }
+    upstreamHeaders = headersResult.value;
+  }
+
+  let upstreamUrl = buildCountTokensUpstreamUrl(resolvedTarget, resolvedProviderConfig, config);
+
+  if (willOverrideCredential) {
+    const credentialOverride = applyProviderCredentials(
+      upstreamUrl,
+      upstreamHeaders,
+      resolvedTarget.provider,
+      resolvedProviderConfig!.apikey!
+    );
+    upstreamUrl = credentialOverride.url;
+    upstreamHeaders = credentialOverride.headers;
+  }
+
+  const upstreamBody = applyPassthroughModelOverride(
+    { url: upstreamUrl, headers: upstreamHeaders, body },
+    resolvedTarget.provider,
+    resolvedModel
+  ).body;
+
+  let upstreamResponse: Response;
+  try {
+    upstreamResponse = await callUpstream(
+      upstreamUrl,
+      upstreamHeaders,
+      upstreamBody,
+      config.upstreamTimeoutMs,
+      clientAbortSignal,
+      {
+        logger: request.log,
+        provider: resolvedTarget.provider,
+        providerName: resolvedProviderConfig?.name,
+        sourceAdapterKey: source.adapterKey
+      }
+    );
+  } catch (error) {
+    if (clientAbortSignal.aborted) {
+      return;
+    }
+
+    return reply.code(502).send({
+      error: {
+        message: error instanceof Error ? error.message : 'Failed to reach upstream provider.'
+      }
+    });
+  }
+
+  if (clientAbortSignal.aborted) {
+    return;
+  }
+
+  return relayUpstreamResponse(reply, upstreamResponse, clientAbortSignal);
+}
+
+// Minimal Anthropic-shaped headers for a target whose credential will be overridden by
+// applyProviderCredentials (an explicit local providerConfig with its own apikey). No
+// authorization/x-api-key is resolved here — the credential override sets it — so a request
+// with no incoming/managed Anthropic credential still reaches the local leg.
+function buildCountTokensLocalPassthroughHeaders(headers: FastifyRequest['headers']): Record<string, string> {
+  const mapped: Record<string, string> = {
+    'content-type': 'application/json',
+    'anthropic-version':
+      readHeader(headers['anthropic-version']) ||
+      readHeader(headers['x-anthropic-version']) ||
+      process.env.ANTHROPIC_VERSION ||
+      '2023-06-01'
+  };
+
+  const beta = readHeader(headers['anthropic-beta']);
+  if (beta) {
+    mapped['anthropic-beta'] = beta;
+  }
+
+  return mapped;
+}
+
+function buildCountTokensUpstreamUrl(
+  target: TargetProviderRoute,
+  targetProviderConfig: ProviderConfig | undefined,
+  config: GatewayConfig
+): string {
+  const baseUrl =
+    targetProviderConfig?.baseurl || providerBaseUrlForType(target.provider, config) || config.anthropicBaseUrl;
+  const trimmedBaseUrl = trimRightSlash(baseUrl);
+  return trimmedBaseUrl.endsWith('/v1')
+    ? `${trimmedBaseUrl}/messages/count_tokens`
+    : `${trimmedBaseUrl}/v1/messages/count_tokens`;
+}
