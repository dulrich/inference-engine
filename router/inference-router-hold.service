[Unit]
Description=inference-router socket hold (never runs a router)
# The Service= of the inference-router sockets. It does nothing and stays active, so systemd
# never starts a generation on traffic; generations are started only by install.sh.

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
# systemd sets O_NONBLOCK on every passed socket to this value at each start. The flag lives on
# the open file description a running generation shares, so the default (clear it) would turn
# that generation's accept into a blocking call and hang it. Measured 2026-11-18.
NonBlocking=yes

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
PrivateUsers=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
RestrictAddressFamilies=none
IPAddressDeny=any
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed
UMask=0077
