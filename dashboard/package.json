{
  "name": "bench-dashboard",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "cargo run -p bench-dashboard-server --bin inference-dashboard & bun run --filter '@bench-dashboard/web' dev",
    "dev:web": "bun run --filter '@bench-dashboard/web' dev",
    "build": "bun run --filter '@bench-dashboard/web' build",
    "ingest": "cargo run -q --locked -p bench-dashboard-server --bin inference-dashboard -- ingest",
    "harness": "bun harness/run.ts",
    "test": "bun run test:web",
    "test:web": "bun test apps/web/src apps/web/build.test.ts",
    "check:recipes": "cargo run -q --locked -p bench-dashboard-server --bin check-recipes --",
    "design:verify": "bash <code-root>/fleet-tools/signalworks/install.sh --verify --dest .",
    "webkit:verify": "bash <code-root>/fleet-tools/webkit/install.sh --verify --dest .",
    "test:theme": "bun packages/signalworks/scripts/check-contrast.mjs --signalworks packages/signalworks/css apps/web/src",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives && bun packages/webkit/svelte-template-lint.ts && biome lint",
    "typecheck": "tsc -p packages/shared/tsconfig.json && tsc -p harness/tsconfig.json && bun run --filter '@bench-dashboard/web' check",
    "test:security": "trivy fs --scanners vuln,misconfig --include-dev-deps --skip-db-update --skip-check-update --exit-code 1 --severity CRITICAL,HIGH .",
    "test:rust": "cargo fmt --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace",
    "audit:rust": "cargo audit",
    "test:contract-drift": "cargo run -q --locked -p bench-dashboard-domain --bin gen-ts | cmp packages/shared/src/index.ts -",
    "image": "docker build -t inference-dashboard:dev ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/bun": "^1.3.14",
    "lucide-svelte": "^0.468.0",
    "oxlint": "^1.0.0",
    "svelte": "^5.46.4",
    "svelte-check": "^4.0.0",
    "typescript": "^5.6.0"
  }
}
