+    }, FINALIZE_GRACE_MS);
+    this.finalizeTimer.unref?.();
+  }
+
+  /** Write the terminal `request` record. Exactly once, always after the last progress line. */
+  finalize(): void {
+    if (this.finalized) {
+      return;
+    }
+    this.finalized = true;
+    this.stopProgress();
+    if (this.finalizeTimer) {
+      clearTimeout(this.finalizeTimer);
+      this.finalizeTimer = undefined;
+    }
+
+    const now = Date.now();
+    this.sink.write(
+      {
+        kind: 'request',
+        ts: new Date(now).toISOString(),
+        reqId: this.reqId,
+        route: this.route,
+        method: this.method,
+        sourceAdapterKey: this.sourceAdapterKey,
+        leg: this.leg ?? null,
+        providerType: this.providerType ?? null,
+        upstreamUrl: this.upstreamUrl ?? null,
+        sessionId: this.sessionId ?? null,
+        isSubagent: this.isSubagent,
+        modelRequested: this.modelRequested ?? null,
+        modelResolved: this.modelResolved ?? null,
+        stream: this.stream,
+        status: this.statusCode() ?? null,
+        attemptSequence: this.attemptSequence,
+        usage: {
+          input: this.usage.input ?? null,
+          output: this.usage.output ?? null,
+          cacheRead: this.usage.cacheRead ?? null,
+          cacheWrite: this.usage.cacheWrite ?? null
+        },
+        responseTokens: this.responseTokens,
+        reasoningTokens: this.reasoningTokens,
+        ttftMs:
+          this.firstContentAt === undefined ? null : this.firstContentAt - this.startedAt,
+        upstreamFirstByteMs:
+          this.upstreamFirstByteAt === undefined
+            ? null
+            : this.upstreamFirstByteAt - this.startedAt,
+        wallMs: now - this.startedAt,
+        upstreamTimings: this.upstreamTimings,
+        stopReason: this.stopReason ?? null,
+        error: this.error ? { stage: this.error.stage, message: this.error.message ?? null } : null
+      },
+      this.logger
+    );
+  }
+
+  dispose(): void {
+    this.stopProgress();
+    if (this.finalizeTimer) {
+      clearTimeout(this.finalizeTimer);
+      this.finalizeTimer = undefined;
+    }
+  }
+}
+
+/**
+ * Live contexts are held weakly by the Fastify request object: a request that never reaches a
+ * terminal record (a socket the process never sees close) is collected with its request, so a
+ * telemetry context can never accumulate into the container's 256 MiB budget.
+ */
+let liveContexts = new WeakMap<object, RequestTelemetryContext>();
+
+function contextFor(request: unknown): RequestTelemetryContext | undefined {
+  if (typeof request !== 'object' || request === null) {
+    return undefined;
+  }
+  return liveContexts.get(request);
+}
+
+function safely(run: () => void): void {
+  try {
+    run();
+  } catch {
+    // Telemetry never fails a request.
+  }
+}
+
+/**
+ * Open a telemetry context for one gateway request. Called at the top of
+ * `handleGatewayRequest`, before target resolution, because the session id and the subagent
+ * witness live in the **client** body: the conversion leg drops `metadata` (and `thinking`,
+ * `reasoning_effort`, `output_config`) before the upstream body is built, so they are
+ * unreadable anywhere downstream.
+ */
+export function beginRequestTelemetry(
+  request: FastifyRequest,
+  reply: FastifyReply,
+  sourceAdapterKey: string,
+  body: Record<string, unknown>,
+  isStreaming: boolean
+): void {
+  safely(() => {
+    const sink = getSink();
+    if (!sink || sink.isDisabled || liveContexts.has(request)) {
+      return;
+    }
+
+    const logger = (request as unknown as { log?: TelemetryLogger }).log;
+    const context = new RequestTelemetryContext({
+      sink,
+      logger,
+      reqId: String((request as unknown as { id?: unknown }).id ?? ''),
+      route: sanitizeRoute(typeof request.url === 'string' ? request.url : ''),
+      method: typeof request.method === 'string' ? request.method : '',
+      sourceAdapterKey,
+      modelRequested: asString(body.model),
+      sessionId: readClaudeCodeSessionId(body),
+      isSubagent: readSubagentWitness(body),
+      stream: isStreaming,
+      statusCode: () => {
+        const raw = (reply as unknown as { raw?: { statusCode?: number } }).raw;
+        return typeof raw?.statusCode === 'number' ? raw.statusCode : undefined;
+      }
+    });
+    liveContexts.set(request, context);
+    if (isStreaming) {
+      context.startStream();
+    }
+
+    const raw = (reply as unknown as { raw?: { on?: (event: string, fn: () => void) => void } })
+      .raw;
+    raw?.on?.('close', () => {
+      safely(() => {
+        context.scheduleFinalize();
+        setTimeout(() => {
+          context.dispose();
+          liveContexts.delete(request);
+        }, FINALIZE_GRACE_MS * 2).unref?.();
+      });
+    });
+  });
+}
+
+/** Record one upstream attempt: leg, provider type, upstream url, resolved model. */
+export function noteRequestTelemetryAttempt(
+  request: unknown,
+  attempt: TelemetryAttempt
+): void {
+  safely(() => contextFor(request)?.noteAttempt(attempt));
+}
+
+/** Record the failing stage/message from the attempts envelope (never a body, never a header). */
+export function noteRequestTelemetryFailure(
+  request: unknown,
+  stage: string,
+  message?: string
+): void {
+  safely(() => contextFor(request)?.noteFailure(stage, message));
+}
+
+/** Record the usage block the engine's own billing computation produced. */
+export function noteRequestTelemetryUsage(
+  request: unknown,
+  usage: TelemetryUsage,
+  model?: string
+): void {
+  safely(() => contextFor(request)?.noteUsage(usage, model));
+}
+
+/** Feed decoded upstream SSE text to the context (used by the stream tap and by tests). */
+export function noteRequestTelemetryStreamText(
+  request: unknown,
+  text: string,
+  shape: SseShape
+): void {
+  safely(() => contextFor(request)?.observeUpstreamText(text, shape));
+}
+
+/** Write the terminal record now (used by tests and by the synchronous failure paths). */
+export function finishRequestTelemetry(request: unknown): void {
+  safely(() => {
+    const context = contextFor(request);
+    if (!context) {
+      return;
+    }
+    context.finalize();
+    context.dispose();
+    if (typeof request === 'object' && request !== null) {
+      liveContexts.delete(request);
+    }
+  });
+}
+
+/**
+ * Wrap an upstream streaming response so every byte relayed to the client is also observed by
+ * this request's telemetry context. Pass-through, no buffering, no re-ordering: the transform
+ * enqueues each chunk unchanged. Any failure returns the original response untouched.
+ */
+export function tapUpstreamStreamForTelemetry(
+  request: unknown,
+  upstreamResponse: Response,
+  shape: SseShape
+): Response {
+  const context = contextFor(request);
+  if (!context || !upstreamResponse.body) {
+    return upstreamResponse;
+  }
+  const status = upstreamResponse.status;
+  if (status < 200 || status >= 300 || status === 204 || status === 205) {
+    return upstreamResponse;
+  }
+
+  try {
+    const decoder = new TextDecoder();
+    context.startStream();
+    const transform = new TransformStream<Uint8Array, Uint8Array>({
+      transform: (chunk, controller) => {
+        safely(() => context.observeUpstreamText(decoder.decode(chunk, { stream: true }), shape));
+        controller.enqueue(chunk);
+      },
+      flush: () => {
+        safely(() => context.endStream());
+      }
+    });
+    const tapped = upstreamResponse.body.pipeThrough(transform);
+    return new Response(tapped as unknown as ConstructorParameters<typeof Response>[0], {
+      status,
+      statusText: upstreamResponse.statusText,
+      headers: upstreamResponse.headers
+    });
+  } catch {
+    context.endStream();
+    return upstreamResponse;
+  }
+}
+
+function sanitizeRoute(url: string): string {
+  const queryIndex = url.indexOf('?');
+  return queryIndex === -1 ? url : url.slice(0, queryIndex);
+}
+
+/**
+ * Claude Code carries its session id inside `metadata.user_id`, a single opaque string of the
+ * shape `user_<hash>_account_<uuid>_session_<uuid>`. Only the session segment is extracted —
+ * the account/user segments are identity material and never reach the sink.
+ */
+export function readClaudeCodeSessionId(body: Record<string, unknown>): string | undefined {
+  const metadata = isRecord(body.metadata) ? body.metadata : undefined;
+  const userId = metadata ? asString(metadata.user_id) : undefined;
+  if (userId) {
+    const match = /_session_([A-Za-z0-9-]{8,})/.exec(userId);
+    if (match) {
+      return match[1];
+    }
+  }
+  const direct = metadata ? asString(metadata.session_id) ?? asString(metadata.sessionId) : undefined;
+  return direct;
+}
+
+/**
+ * Claude Code marks a subagent turn with a `cc_is_subagent=true;` witness in the billing line
+ * of the first system block. Only the boolean is kept; the system text itself never is.
+ */
+export function readSubagentWitness(body: Record<string, unknown>): boolean {
+  const system = body.system;
+  let text: string | undefined;
+  if (typeof system === 'string') {
+    text = system;
+  } else if (Array.isArray(system) && system.length > 0 && isRecord(system[0])) {
+    text = asString((system[0] as Record<string, unknown>).text);
+  }
+  return typeof text === 'string' && text.includes('cc_is_subagent=true');
+}
+
+function readOpenAIUsage(value: unknown): TelemetryUsage {
+  if (!isRecord(value)) {
+    return {};
+  }
+  const details = isRecord(value.prompt_tokens_details) ? value.prompt_tokens_details : undefined;
+  return {
+    input: asNumber(value.prompt_tokens),
+    output: asNumber(value.completion_tokens),
+    cacheRead: details ? asNumber(details.cached_tokens) : undefined
+  };
+}
+
+function readAnthropicUsage(value: unknown): TelemetryUsage {
+  if (!isRecord(value)) {
+    return {};
+  }
+  return {
+    input: asNumber(value.input_tokens),
+    output: asNumber(value.output_tokens),
+    cacheRead: asNumber(value.cache_read_input_tokens),
+    cacheWrite: asNumber(value.cache_creation_input_tokens)
+  };
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
+
+function asString(value: unknown): string | undefined {
+  return typeof value === 'string' && value.trim() ? value : undefined;
+}
+
+function asNumber(value: unknown): number | undefined {
+  return typeof value === 'number' && Number.isFinite(value) ? value : undefined;
+}
