+/**
+ * The level's own row when the model declares it; otherwise, for `xhigh`/`max` only, the `high`
+ * row. Anything else (including an undeclared `low`, `medium`, `high` or `disabled`) stays a
+ * passthrough — the Qwen3.8 template 500s on a `reasoning_effort` value it does not know, so an
+ * unmapped level is never a guess.
+ */
+function readEffortKwargsForLevel(
+  levels: Record<string, unknown>,
+  level: EffortKwargsLevel
+): unknown {
+  const exact = levels[level];
+  if (isEffortKwargsRecord(exact)) {
+    return exact;
+  }
+  return EFFORT_KWARGS_HIGH_FALLBACK_LEVELS.has(level) ? levels.high : undefined;
+}
