[Unit]
Description=llama-swap slot poller (writes slots-YYYY-MM-DD.jsonl for the bench dashboard Router view)
After=network.target

[Service]
Type=simple
ExecStart=@BUN@ @POLLER@ --base-url @BASE_URL@ --out-dir @OUT_DIR@
Environment=PATH=@PATH@
StandardInput=null
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
