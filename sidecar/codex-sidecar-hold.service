[Unit]
Description=codex-sidecar socket hold (never runs a sidecar)
# The Service= of both codex-sidecar sockets. It does nothing and stays active, so systemd
# never starts a generation on traffic; generations are started only by install.sh.

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
PrivateUsers=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
RestrictAddressFamilies=none
IPAddressDeny=any
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed
UMask=0077
