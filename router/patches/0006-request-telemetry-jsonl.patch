+const MAX_PROGRESS_RECORDS = 3600;
+/** Flush when the pending whole-line buffer reaches this, or on the timer below. */
+const FLUSH_BUFFER_BYTES = 64 * 1024;
+const FLUSH_INTERVAL_MS = 250;
