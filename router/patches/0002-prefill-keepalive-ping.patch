+import { afterEach, describe, expect, it, vi } from 'vitest';
+import {
+  optimisticStreamKeepAliveFrame,
+  preStartSafeAnthropicPingFrame,
+  withIdleGapKeepAlive
+} from './streaming-conversion';
+
+/**
+ * A hand-rolled async generator test double: yields whatever is `push()`-ed, in order,
+ * finishes on `end()`, throws on `fail()`. When nothing is queued it parks on a promise
+ * that only `push`/`end`/`fail` can resolve — the same "no data yet" shape
+ * `relayAnthropicMessagesFromOpenAIStream` presents while waiting on the real upstream.
+ */
+function createControllableGenerator() {
+  type QueueItem =
+    | { kind: 'value'; value: string }
+    | { kind: 'done' }
+    | { kind: 'error'; error: unknown };
+
+  const queue: QueueItem[] = [];
+  let wake: (() => void) | undefined;
+  let cleanedUp = false;
+
+  async function* run(): AsyncGenerator<string> {
+    try {
+      for (;;) {
+        if (queue.length === 0) {
+          await new Promise<void>((resolve) => {
+            wake = resolve;
+          });
+          continue;
+        }
+
+        const item = queue.shift() as QueueItem;
+        if (item.kind === 'value') {
+          yield item.value;
+        } else if (item.kind === 'done') {
+          return;
+        } else {
+          throw item.error;
+        }
+      }
+    } finally {
+      cleanedUp = true;
+    }
+  }
+
+  return {
+    generator: run(),
+    push(value: string) {
+      queue.push({ kind: 'value', value });
+      wake?.();
+      wake = undefined;
+    },
+    end() {
+      queue.push({ kind: 'done' });
+      wake?.();
+      wake = undefined;
+    },
+    fail(error: unknown) {
+      queue.push({ kind: 'error', error });
+      wake?.();
+      wake = undefined;
+    },
+    isCleanedUp() {
+      return cleanedUp;
+    }
+  };
+}
+
+/** Never produces a frame and never finishes — models an upstream stuck mid-prefill. */
+function createBlockedForeverGenerator() {
+  async function* run(): AsyncGenerator<string> {
+    await new Promise<void>(() => {});
+    yield 'unreachable';
+  }
+
+  return run();
+}
+
+describe('preStartSafeAnthropicPingFrame', () => {
+  it('emits the exact ping frame bytes', () => {
+    expect(preStartSafeAnthropicPingFrame()).toBe('event: ping\ndata: {"type":"ping"}\n\n');
+  });
+
+  it('is unconditional, unlike optimisticStreamKeepAliveFrame which is post-start-gated', () => {
+    const preStartRelay = {
+      sourceAdapterKey: 'anthropic_messages',
+      state: { started: false }
+    } as never;
+
+    // The existing, post-start-gated helper degrades to a comment before message_start...
+    expect(optimisticStreamKeepAliveFrame(preStartRelay)).toBe(': keep-alive\n\n');
+    // ...while the new helper emits the real ping frame regardless of any relay state at all
+    // (it takes none), which is the entire reason it exists as a separate helper.
+    expect(preStartSafeAnthropicPingFrame()).toBe('event: ping\ndata: {"type":"ping"}\n\n');
+  });
+});
+
+describe('withIdleGapKeepAlive', () => {
+  afterEach(() => {
+    vi.useRealTimers();
+  });
+
+  it('yields a ping frame during pre-first-frame silence', async () => {
+    vi.useFakeTimers();
+    const inner = createBlockedForeverGenerator();
+    const wrapped = withIdleGapKeepAlive(inner, () => 'PING', 1000);
+
+    const pending = wrapped.next();
+    await vi.advanceTimersByTimeAsync(1000);
+    await expect(pending).resolves.toEqual({ value: 'PING', done: false });
+  });
+
+  it('repeats the ping for as long as the gap persists', async () => {
+    vi.useFakeTimers();
+    const inner = createBlockedForeverGenerator();
+    const wrapped = withIdleGapKeepAlive(inner, () => 'PING', 1000);
+
+    for (let i = 0; i < 3; i += 1) {
+      const pending = wrapped.next();
+      await vi.advanceTimersByTimeAsync(1000);
+      await expect(pending).resolves.toEqual({ value: 'PING', done: false });
+    }
+  });
+
+  it('never pings while inner frames arrive faster than the interval', async () => {
+    const control = createControllableGenerator();
+    const wrapped = withIdleGapKeepAlive(control.generator, () => 'PING', 10_000);
+    const seen: unknown[] = [];
+
+    control.push('frame-1');
+    seen.push((await wrapped.next()).value);
+
+    await new Promise((resolve) => setTimeout(resolve, 5));
+    control.push('frame-2');
+    seen.push((await wrapped.next()).value);
+
+    await new Promise((resolve) => setTimeout(resolve, 5));
+    control.end();
+    const final = await wrapped.next();
+
+    expect(seen).toEqual(['frame-1', 'frame-2']);
+    expect(final).toEqual({ value: undefined, done: true });
+  });
+
+  it('forwards inner frames byte-identical and in order, never reordered or dropped', async () => {
+    const control = createControllableGenerator();
+    const wrapped = withIdleGapKeepAlive(control.generator, () => 'PING', 10_000);
+    const frames = [
+      'event: message_start\ndata: {"type":"message_start"}\n\n',
+      'event: content_block_delta\ndata: {"type":"content_block_delta","delta":{"text":"hi"}}\n\n',
+      'event: message_stop\ndata: {"type":"message_stop"}\n\n'
+    ];
+
+    for (const frame of frames) {
+      control.push(frame);
+    }
+    control.end();
+
+    const received: string[] = [];
+    for (;;) {
+      const result = await wrapped.next();
+      if (result.done) {
+        break;
+      }
+      received.push(result.value);
+    }
+
+    expect(received).toHaveLength(frames.length);
+    frames.forEach((frame, index) => {
+      expect(received[index]).toBe(frame);
+    });
+  });
+
+  it('stops permanently once inner finishes — no trailing frames after the terminal event', async () => {
+    vi.useFakeTimers();
+    const control = createControllableGenerator();
+    const wrapped = withIdleGapKeepAlive(control.generator, () => 'PING', 1000);
+
+    control.push('frame-1');
+    await expect(wrapped.next()).resolves.toEqual({ value: 'frame-1', done: false });
+
+    control.end();
+    await expect(wrapped.next()).resolves.toEqual({ value: undefined, done: true });
+
+    // No timer should still be scheduled once the inner generator has finished.
+    expect(vi.getTimerCount()).toBe(0);
+
+    // Advancing well past the interval, repeatedly, must not resurrect a ping.
+    await vi.advanceTimersByTimeAsync(5000);
+    expect(vi.getTimerCount()).toBe(0);
+    await expect(wrapped.next()).resolves.toEqual({ value: undefined, done: true });
+  });
+
+  it('propagates an inner error and leaves no leaked timer', async () => {
+    vi.useFakeTimers();
+    const control = createControllableGenerator();
+    const wrapped = withIdleGapKeepAlive(control.generator, () => 'PING', 1000);
+
+    control.push('frame-1');
+    await expect(wrapped.next()).resolves.toEqual({ value: 'frame-1', done: false });
+
+    const boom = new Error('upstream exploded');
+    control.fail(boom);
+    await expect(wrapped.next()).rejects.toBe(boom);
+
+    expect(vi.getTimerCount()).toBe(0);
+    expect(control.isCleanedUp()).toBe(true);
+  });
+
+  it('closes the inner generator and clears its timer on external return() (abort path)', async () => {
+    vi.useFakeTimers();
+    const control = createControllableGenerator();
+    const wrapped = withIdleGapKeepAlive(control.generator, () => 'PING', 1000);
+
+    control.push('frame-1');
+    await expect(wrapped.next()).resolves.toEqual({ value: 'frame-1', done: false });
+
+    // Mirrors what Readable.from()'s destroy handling does when
+    // bindAbortSignalToReadable's onAbort fires on client disconnect.
+    const returned = await wrapped.return(undefined);
+
+    expect(returned).toEqual({ value: undefined, done: true });
+    expect(vi.getTimerCount()).toBe(0);
+    expect(control.isCleanedUp()).toBe(true);
+
+    await expect(wrapped.next()).resolves.toEqual({ value: undefined, done: true });
+  });
+});
