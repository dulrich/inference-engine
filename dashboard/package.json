{
  "name": "bench-dashboard",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter '@bench-dashboard/api' dev & bun run --filter '@bench-dashboard/web' dev",
    "dev:api": "bun run --filter '@bench-dashboard/api' dev",
    "dev:web": "bun run --filter '@bench-dashboard/web' dev",
    "build": "bun run --filter '@bench-dashboard/web' build && bun run --filter '@bench-dashboard/api' build",
    "start": "bun run --filter '@bench-dashboard/api' start",
    "ingest": "bun run --filter '@bench-dashboard/api' ingest",
    "smoke": "bun run --filter '@bench-dashboard/api' smoke",
    "test": "bun test apps packages/shared scripts",
    "check:recipes": "bun scripts/check-serving-recipes.ts",
    "lint": "oxlint --deny-warnings && bun packages/webkit/svelte-template-lint.ts && biome lint",
    "typecheck": "tsc -p packages/shared/tsconfig.json && tsc -p apps/api/tsconfig.json && bun run --filter '@bench-dashboard/web' check",
    "test:theme": "bun packages/signalworks/scripts/check-contrast.mjs --signalworks packages/signalworks/css apps/web/src",
    "design:verify": "bash <code-root>/fleet-tools/signalworks/install.sh --verify --dest .",
    "webkit:verify": "bash <code-root>/fleet-tools/webkit/install.sh --verify --dest .",
    "test:security": "trivy fs --scanners vuln,misconfig --include-dev-deps --skip-db-update --skip-check-update --exit-code 1 --severity CRITICAL,HIGH ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/bun": "^1.3.14",
    "oxlint": "^1.0.0",
    "svelte": "^5.46.4",
    "svelte-check": "^4.0.0",
    "typescript": "^5.6.0"
  }
}
