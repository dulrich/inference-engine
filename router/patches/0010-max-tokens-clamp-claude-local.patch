+/**
+ * `maxOutputTokens`: per-model answer-token ceiling (patch 0010). Model keys are validated
+ * against the provider's own `models[]` and values must be positive integers; anything else is
+ * dropped silently, never a load-time throw, and the field stays undefined when nothing
+ * survives — so a malformed entry degrades to "no clamp", never to a wrong clamp.
+ */
+function parseProviderMaxOutputTokens(
+  value: unknown,
+  models: string[]
+): ProviderConfig['maxOutputTokens'] {
+  if (!isPlainObject(value)) {
+    return undefined;
+  }
+
+  const modelNames = new Set(models.map((model) => model.trim().toLowerCase()).filter(Boolean));
+  const parsed: NonNullable<ProviderConfig['maxOutputTokens']> = {};
+  for (const [rawModel, rawCap] of Object.entries(value)) {
+    const model = rawModel.trim();
+    if (
+      !model ||
+      typeof rawCap !== 'number' ||
+      !Number.isInteger(rawCap) ||
+      rawCap <= 0 ||
+      (modelNames.size > 0 && !modelNames.has(model.toLowerCase()))
+    ) {
+      continue;
+    }
+
+    parsed[model] = rawCap;
+  }
+
+  return Object.keys(parsed).length > 0 ? parsed : undefined;
+}
