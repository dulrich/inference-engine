+import { describe, expect, it } from 'vitest';
+import { parseProvidersFromRaw } from '../../../../config';
+import type { ProviderConfig, StandardRequest } from '../../../../types';
+import { parseAnthropicMessagesRequest } from '../../source/parsers';
+import { openAIResponsesTargetAdapter } from '../openai-responses';
+import { rewriteOpenAIChatCompatibleRequest } from '../shared';
+import { applyConfiguredMaxOutputTokens } from './max-tokens-clamp';
+
+const MAX_OUTPUT_TOKENS: ProviderConfig['maxOutputTokens'] = {
+  'qwen38-27b-iq3s': 8192
+};
+
+function localProviderConfig(overrides: Partial<ProviderConfig> = {}): ProviderConfig {
+  return {
+    name: 'claude-local',
+    type: 'openai_chat_completions',
+    baseurl: 'http://inference-engine-llama:4806/v1',
+    models: ['qwen38-27b-iq3s', 'qwen36-a3b'],
+    maxOutputTokens: MAX_OUTPUT_TOKENS,
+    ...overrides
+  } as ProviderConfig;
+}
+
+function apply(
+  body: Record<string, unknown>,
+  providerConfig: ProviderConfig | undefined = localProviderConfig(),
+  model = 'qwen38-27b-iq3s'
+): Record<string, unknown> {
+  return applyConfiguredMaxOutputTokens(body, providerConfig, model);
+}
+
+describe('applyConfiguredMaxOutputTokens', () => {
+  it('clamps a request above the declared cap, on either budget key', () => {
+    expect(apply({ model: 'qwen38-27b-iq3s', max_tokens: 32000 }).max_tokens).toBe(8192);
+    expect(
+      apply({ model: 'qwen38-27b-iq3s', max_completion_tokens: 64000 }).max_completion_tokens
+    ).toBe(8192);
+  });
+
+  it('passes a budget below or equal to the cap through byte-untouched, and never raises it', () => {
+    const below = { model: 'qwen38-27b-iq3s', max_tokens: 256 };
+    expect(apply(below)).toBe(below);
+
+    const equal = { model: 'qwen38-27b-iq3s', max_tokens: 8192 };
+    expect(apply(equal)).toBe(equal);
+  });
+
+  it('sends the declared cap when the request carries no budget at all', () => {
+    expect(apply({ model: 'qwen38-27b-iq3s' }).max_tokens).toBe(8192);
+    // An explicitly-undefined key (how the conversion leg spells an absent max_output_tokens)
+    // is absent, not a value.
+    expect(apply({ model: 'qwen38-27b-iq3s', max_tokens: undefined }).max_tokens).toBe(8192);
+  });
+
+  it('leaves a present-but-unreadable budget alone rather than guessing', () => {
+    const body = { model: 'qwen38-27b-iq3s', max_tokens: '32000' };
+    expect(apply(body)).toBe(body);
+    expect(apply(body).max_tokens).toBe('32000');
+  });
+
+  it('leaves every other key on the body untouched', () => {
+    const body = {
+      model: 'qwen38-27b-iq3s',
+      messages: [],
+      temperature: 0,
+      max_tokens: 32000,
+      chat_template_kwargs: { reasoning_effort: 'low' }
+    };
+    const next = apply(body);
+
+    expect(next.model).toBe('qwen38-27b-iq3s');
+    expect(next.messages).toBe(body.messages);
+    expect(next.temperature).toBe(0);
+    expect(next.chat_template_kwargs).toBe(body.chat_template_kwargs);
+    expect(body.max_tokens).toBe(32000);
+  });
+
+  it('is idempotent, so the per-attempt rewrite over an already-clamped body is a no-op', () => {
+    const clamped = apply({ model: 'qwen38-27b-iq3s', max_tokens: 32000 });
+    expect(apply(clamped)).toBe(clamped);
+  });
+
+  it('is a no-op without a map, for a model the map omits, and for a non-chat target', () => {
+    const bare = { model: 'qwen38-27b-iq3s', max_tokens: 32000 };
+    expect(apply(bare, localProviderConfig({ maxOutputTokens: undefined }))).toBe(bare);
+
+    const other = { model: 'qwen36-a3b', max_tokens: 32000 };
+    expect(apply(other, localProviderConfig(), 'qwen36-a3b')).toBe(other);
+
+    const anthropicTarget = localProviderConfig({
+      type: 'anthropic_messages' as ProviderConfig['type']
+    });
+    const hosted = { model: 'qwen38-27b-iq3s', max_tokens: 32000 };
+    expect(apply(hosted, anthropicTarget)).toBe(hosted);
+    expect(applyConfiguredMaxOutputTokens(hosted, undefined, 'qwen38-27b-iq3s')).toBe(hosted);
+  });
+});
+
+describe('rewriteOpenAIChatCompatibleRequest with maxOutputTokens', () => {
+  it('clamps on the conversion leg beside the effort mapping', () => {
+    const rewritten = rewriteOpenAIChatCompatibleRequest(
+      { model: 'qwen38-27b-iq3s', messages: [], max_tokens: 32000 },
+      localProviderConfig(),
+      { standardRequest: { model: 'qwen38-27b-iq3s' } as StandardRequest }
+    ) as Record<string, unknown>;
+
+    expect(rewritten.max_tokens).toBe(8192);
+  });
+
+  it('clamps on the per-attempt call without a standardRequest too, and stays idempotent', () => {
+    const once = rewriteOpenAIChatCompatibleRequest(
+      { model: 'qwen38-27b-iq3s', messages: [], max_tokens: 32000 },
+      localProviderConfig()
+    ) as Record<string, unknown>;
+    expect(once.max_tokens).toBe(8192);
+
+    const twice = rewriteOpenAIChatCompatibleRequest(once, localProviderConfig()) as Record<
+      string,
+      unknown
+    >;
+    expect(twice.max_tokens).toBe(8192);
+  });
+});
+
+describe('maxOutputTokens end to end', () => {
+  it('reaches the upstream body built from an Anthropic-shape request', () => {
+    const parsed = parseAnthropicMessagesRequest({
+      model: 'qwen38-27b-iq3s',
+      max_tokens: 32000,
+      messages: [{ role: 'user', content: 'hello' }]
+    });
+
+    expect(parsed.ok).toBe(true);
+    if (!parsed.ok) {
+      return;
+    }
+
+    const built = openAIResponsesTargetAdapter.buildRequestFromStandard({
+      request: { headers: {} } as never,
+      standardRequest: parsed.value,
+      config: { openaiApiKey: 'sk-test', openaiBaseUrl: 'https://mock.local/v1' } as never,
+      targetProviderConfig: localProviderConfig() as never
+    });
+
+    expect(built.ok).toBe(true);
+    if (!built.ok) {
+      return;
+    }
+
+    const body = built.value.body as Record<string, unknown>;
+    expect(body.max_tokens).toBe(8192);
+    expect(body.model).toBe('qwen38-27b-iq3s');
+  });
+
+  it('leaves the upstream body untouched when the provider has no map', () => {
+    const parsed = parseAnthropicMessagesRequest({
+      model: 'qwen38-27b-iq3s',
+      max_tokens: 32000,
+      messages: [{ role: 'user', content: 'hello' }]
+    });
+
+    expect(parsed.ok).toBe(true);
+    if (!parsed.ok) {
+      return;
+    }
+
+    const built = openAIResponsesTargetAdapter.buildRequestFromStandard({
+      request: { headers: {} } as never,
+      standardRequest: parsed.value,
+      config: { openaiApiKey: 'sk-test', openaiBaseUrl: 'https://mock.local/v1' } as never,
+      targetProviderConfig: localProviderConfig({ maxOutputTokens: undefined }) as never
+    });
+
+    expect(built.ok).toBe(true);
+    if (!built.ok) {
+      return;
+    }
+
+    expect((built.value.body as Record<string, unknown>).max_tokens).toBe(32000);
+  });
+});
+
+describe('parseProvidersFromRaw maxOutputTokens', () => {
+  it('reads the per-model cap off provider config', () => {
+    const [provider] = parseProvidersFromRaw([
+      {
+        name: 'claude-local',
+        type: 'openai_chat_completions',
+        baseurl: 'http://inference-engine-llama:4806/v1',
+        models: ['qwen36-a3b', 'qwen38-27b-iq3s'],
+        maxOutputTokens: { 'qwen38-27b-iq3s': 32000, 'qwen36-a3b': 32000 }
+      }
+    ]);
+
+    expect(provider.maxOutputTokens).toEqual({
+      'qwen38-27b-iq3s': 32000,
+      'qwen36-a3b': 32000
+    });
+  });
+
+  it('drops unknown model keys and non-positive-integer values, and stays undefined when empty', () => {
+    const [provider] = parseProvidersFromRaw([
+      {
+        name: 'claude-local',
+        type: 'openai_chat_completions',
+        models: ['qwen38-27b-iq3s'],
+        maxOutputTokens: {
+          'qwen38-27b-iq3s': 8192,
+          'not-a-model': 4096
+        }
+      }
+    ]);
+    expect(provider.maxOutputTokens).toEqual({ 'qwen38-27b-iq3s': 8192 });
+
+    const [bad] = parseProvidersFromRaw([
+      {
+        name: 'claude-local',
+        type: 'openai_chat_completions',
+        models: ['qwen38-27b-iq3s'],
+        maxOutputTokens: { 'qwen38-27b-iq3s': '8192' }
+      }
+    ]);
+    expect(bad.maxOutputTokens).toBeUndefined();
+
+    const [zero] = parseProvidersFromRaw([
+      {
+        name: 'claude-local',
+        type: 'openai_chat_completions',
+        models: ['qwen38-27b-iq3s'],
+        maxOutputTokens: { 'qwen38-27b-iq3s': 0 }
+      }
+    ]);
+    expect(zero.maxOutputTokens).toBeUndefined();
+
+    const [absent] = parseProvidersFromRaw([
+      { name: 'claude-local', type: 'openai_chat_completions', models: ['qwen38-27b-iq3s'] }
+    ]);
+    expect(absent.maxOutputTokens).toBeUndefined();
+  });
+});
