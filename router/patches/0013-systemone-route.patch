@@ -0,0 +1,161 @@
+/**
+ * Patch 0013 (systemone-route): POST /v1/systemone — a lean, non-chat decision-model proxy.
+ *
+ * Wire contract (pinned by inference-engine router/AGENTS.md, consumed byte-for-byte by the
+ * fleet-tools stop-wait classifier): the client body is
+ * `{"model":"<provider>/<model-id>","state":"…","questions":{…}}`. It is forwarded verbatim to
+ * `<provider baseurl>/systemone` with only `model` rewritten to the bare model id, and the
+ * upstream status + body are relayed verbatim (errors included, as patch 0003/0004 do).
+ *
+ * Resolution is deliberately strict and separate from the chat legs' fallthrough: the prefix
+ * must name a configured provider of `type: "systemone"`, and the bare id must be listed in that
+ * provider's NON-EMPTY `models[]`. Anything else is a 404 with no upstream call.
+ *
+ * Credentials: the upstream `Authorization: Bearer <key>` comes only from the provider's own
+ * credential (`apikey`, or `apiKeyEnv` resolved at config load). The upstream header set is built
+ * from scratch — no caller header (bearer, x-api-key, gateway key) is ever copied — and a
+ * provider with no resolved credential refuses the request instead of calling upstream.
+ *
+ * Telemetry (patch 0006): one record under the sink's scalar allowlist (route, leg, provider,
+ * model, status, latency). The body's `state`/`questions` are never handed to the sink, and the
+ * upstream call is made without a log context so the engine's request-body info log never
+ * sees them either.
+ */
+
+import type { FastifyReply, FastifyRequest } from 'fastify';
+
+import type { GatewayConfig, ProviderConfig } from '../types';
+import { callUpstream, relayUpstreamResponse } from '../upstream/client';
+import { isObject } from '../utils';
+import { createClientDisconnectSignal } from './client-disconnect';
+import {
+  beginRequestTelemetry,
+  noteRequestTelemetryAttempt,
+  noteRequestTelemetryFailure
+} from './request-telemetry';
+
+export const SYSTEMONE_PROVIDER_TYPE = 'systemone';
+const SOURCE_ADAPTER_KEY = 'systemone';
+
+export interface ResolvedSystemoneTarget {
+  providerConfig: ProviderConfig;
+  model: string;
+}
+
+/** `<provider>/<model-id>` → the systemone provider and bare id, or undefined (→ 404). */
+export function resolveSystemoneTarget(
+  providers: ProviderConfig[] | undefined,
+  requestedModel: unknown
+): ResolvedSystemoneTarget | undefined {
+  if (typeof requestedModel !== 'string') {
+    return undefined;
+  }
+  const raw = requestedModel.trim();
+  const slashIndex = raw.indexOf('/');
+  if (slashIndex <= 0 || slashIndex >= raw.length - 1) {
+    return undefined;
+  }
+  const providerName = raw.slice(0, slashIndex);
+  const model = raw.slice(slashIndex + 1);
+  const providerConfig = (providers || []).find((item) => item.name === providerName);
+  if (!providerConfig || providerConfig.type !== SYSTEMONE_PROVIDER_TYPE) {
+    return undefined;
+  }
+  const models = Array.isArray(providerConfig.models) ? providerConfig.models : [];
+  if (models.length === 0 || !models.includes(model)) {
+    return undefined;
+  }
+  return { providerConfig, model };
+}
+
+export function buildSystemoneUpstreamUrl(baseurl: string): string {
+  return `${baseurl.replace(/\/+$/, '')}/systemone`;
+}
+
+function sendNotFound(reply: FastifyReply, requestedModel: unknown) {
+  return reply.code(404).send({
+    error: {
+      message: `Model not found for /v1/systemone: ${
+        typeof requestedModel === 'string' && requestedModel ? requestedModel : '(none)'
+      }`,
+      type: 'invalid_request_error',
+      code: 'model_not_found'
+    }
+  });
+}
+
+export async function handleSystemoneRequest(
+  request: FastifyRequest,
+  reply: FastifyReply,
+  config: GatewayConfig
+) {
+  const body = request.body;
+  if (!isObject(body)) {
+    return reply.code(400).send({
+      error: { message: 'Request body must be a JSON object.', type: 'invalid_request_error' }
+    });
+  }
+
+  const clientAbortSignal = createClientDisconnectSignal(request, reply);
+  beginRequestTelemetry(request, reply, SOURCE_ADAPTER_KEY, body, false);
+
+  const target = resolveSystemoneTarget(config.providers, body.model);
+  if (!target) {
+    noteRequestTelemetryFailure(request, 'model_resolution', 'Model not found for /v1/systemone.');
+    return sendNotFound(reply, body.model);
+  }
+
+  const { providerConfig, model } = target;
+  const apikey = providerConfig.apikey;
+  if (!providerConfig.baseurl || !apikey) {
+    // Never call upstream without the provider's own credential (and never fall back to the
+    // caller's): a misconfigured or unset apiKeyEnv is a gateway-side 503.
+    noteRequestTelemetryFailure(request, 'provider_config', 'systemone provider has no baseurl or credential.');
+    return reply.code(503).send({
+      error: {
+        message: `Provider ${providerConfig.name} is not configured with a baseurl and credential.`,
+        type: 'api_error',
+        code: 'provider_not_configured'
+      }
+    });
+  }
+
+  const upstreamUrl = buildSystemoneUpstreamUrl(providerConfig.baseurl);
+  const upstreamHeaders: Record<string, string> = {
+    'content-type': 'application/json',
+    authorization: `Bearer ${apikey}`
+  };
+  const upstreamBody = { ...body, model };
+
+  noteRequestTelemetryAttempt(request, {
+    provider: SYSTEMONE_PROVIDER_TYPE,
+    providerName: providerConfig.name,
+    sourceAdapterKey: SOURCE_ADAPTER_KEY,
+    upstreamUrl,
+    model
+  });
+
+  let upstreamResponse: Response;
+  try {
+    upstreamResponse = await callUpstream(
+      upstreamUrl,
+      upstreamHeaders,
+      upstreamBody,
+      config.upstreamTimeoutMs,
+      clientAbortSignal
+    );
+  } catch (error) {
+    if (clientAbortSignal.aborted) {
+      return;
+    }
+    const message = error instanceof Error ? error.message : 'Failed to reach upstream provider.';
+    noteRequestTelemetryFailure(request, 'upstream_connect', message);
+    return reply.code(502).send({ error: { message } });
+  }
+
+  if (clientAbortSignal.aborted) {
+    return;
+  }
+
+  return relayUpstreamResponse(reply, upstreamResponse, clientAbortSignal);
+}
