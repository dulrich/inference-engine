@@ -0,0 +1,107 @@
+import type { ProviderConfig, ProviderMaxOutputTokensConfig } from '../../../../types';
+
+/**
+ * Clamps the upstream request's answer-token budget to a per-model ceiling on
+ * `openai_chat_completions` targets, configured per provider as `maxOutputTokens`.
+ *
+ * Why it exists: Claude Code sends `max_tokens` 32000 by default
+ * (`CLAUDE_CODE_MAX_OUTPUT_TOKENS`, max 64000) and this leg forwards it to llama-server
+ * unclamped, which is how a Qwen3.8-27B interactive session errored on max response tokens
+ * (user decision 2026-09-14). The declared cap is that model's
+ * `metadata.max_output.answer_tokens` in `llama/config.yaml` — the effective cap
+ * `min(publisher recommendation, 32000, context_length)` — crosswalked into
+ * `gateway.config.json` by the `max-tokens-crosswalk` rule of `bun run check:recipes`.
+ *
+ * Invariants (same no-op shape as patch 0007's effort mapping — this can never turn a request
+ * that used to succeed into a failure):
+ *   - only `openai_chat_completions` targets;
+ *   - only models that have a `maxOutputTokens` entry;
+ *   - only DOWNWARD: a budget at or below the cap is byte-untouched, and the cap is never
+ *     raised above what the caller asked for;
+ *   - a budget field that is present but not a readable positive number is left alone rather
+ *     than replaced with a guess;
+ *   - idempotent, so the per-attempt `applyProviderRequestOverrides` pass over an
+ *     already-clamped body is a no-op.
+ */
+
+const MAX_OUTPUT_TOKEN_BODY_KEYS = ['max_tokens', 'max_completion_tokens'] as const;
+
+export function applyConfiguredMaxOutputTokens(
+  body: Record<string, unknown>,
+  targetProviderConfig: ProviderConfig | undefined,
+  model: string | undefined
+): Record<string, unknown> {
+  if (targetProviderConfig?.type !== 'openai_chat_completions') {
+    return body;
+  }
+
+  const cap = readMaxOutputTokensForModel(targetProviderConfig.maxOutputTokens, model);
+  if (cap === undefined) {
+    return body;
+  }
+
+  let nextBody: Record<string, unknown> | undefined;
+  let sawBudgetField = false;
+  for (const key of MAX_OUTPUT_TOKEN_BODY_KEYS) {
+    const declared = readMaxOutputTokensValue(body[key]);
+    if (declared === 'unreadable') {
+      // Present but not a positive finite number: never guessed at, never rewritten.
+      sawBudgetField = true;
+      continue;
+    }
+    if (declared === undefined) {
+      continue;
+    }
+    sawBudgetField = true;
+    if (declared > cap) {
+      nextBody = { ...(nextBody ?? body), [key]: cap };
+    }
+  }
+
+  if (!sawBudgetField) {
+    // No budget on the wire at all: send the declared cap rather than letting the upstream
+    // default run to the context window.
+    nextBody = { ...(nextBody ?? body), max_tokens: cap };
+  }
+
+  return nextBody ?? body;
+}
+
+/** `undefined` for an absent/null field, `'unreadable'` for a present non-positive-number one. */
+function readMaxOutputTokensValue(value: unknown): number | 'unreadable' | undefined {
+  if (value === undefined || value === null) {
+    return undefined;
+  }
+  if (typeof value === 'number' && Number.isFinite(value) && value > 0) {
+    return value;
+  }
+  return 'unreadable';
+}
+
+function readMaxOutputTokensForModel(
+  config: ProviderMaxOutputTokensConfig | undefined,
+  model: string | undefined
+): number | undefined {
+  const key = model?.trim();
+  if (!key || !isMaxOutputTokensRecord(config)) {
+    return undefined;
+  }
+
+  const direct = config[key];
+  if (typeof direct === 'number') {
+    return direct;
+  }
+
+  const normalized = key.toLowerCase();
+  for (const [candidate, cap] of Object.entries(config)) {
+    if (candidate.trim().toLowerCase() === normalized && typeof cap === 'number') {
+      return cap;
+    }
+  }
+
+  return undefined;
+}
+
+function isMaxOutputTokensRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
