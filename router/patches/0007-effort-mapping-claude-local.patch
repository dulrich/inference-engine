@@ -0,0 +1,161 @@
+import type { ProviderConfig, ProviderEffortKwargsConfig, StandardRequest } from '../../../../types';
+
+/**
+ * Maps the Anthropic-protocol reasoning intent (`thinking` / `output_config.effort`) that the
+ * Anthropic -> openai_chat_completions conversion leg otherwise drops onto a per-model
+ * `chat_template_kwargs` object, configured per provider as `effortKwargs`.
+ *
+ * Invariants (never a 400, never an unmapped value):
+ *   - only `openai_chat_completions` targets;
+ *   - only models that have an `effortKwargs` map entry;
+ *   - only levels that map entry lists;
+ *   - a no-op without a `standardRequest` (the per-attempt `applyProviderRequestOverrides` call
+ *     runs this same rewrite without one and must not disturb an already-merged object);
+ *   - keys already on the body win, so a caller-supplied kwargs value is never overwritten.
+ *     `extraBody` is deep-merged into the body *after* this step by the handler, so a static
+ *     `extraBody[model].chat_template_kwargs` also still wins.
+ */
+
+export type EffortKwargsLevel = 'low' | 'medium' | 'high' | 'disabled';
+
+/** budget_tokens cut points (plan WP-2 / audit E1); 8192 is the unsuffixed entry's backstop. */
+const EFFORT_KWARGS_BUDGET_LOW_MAX = 2048;
+const EFFORT_KWARGS_BUDGET_MEDIUM_MAX = 8192;
+
+export function applyConfiguredEffortKwargs(
+  body: Record<string, unknown>,
+  targetProviderConfig: ProviderConfig | undefined,
+  standardRequest: StandardRequest | undefined,
+  model: string | undefined
+): Record<string, unknown> {
+  if (!standardRequest || targetProviderConfig?.type !== 'openai_chat_completions') {
+    return body;
+  }
+
+  const levels = readEffortKwargsForModel(targetProviderConfig.effortKwargs, model);
+  if (!levels) {
+    return body;
+  }
+
+  const level = deriveEffortKwargsLevel(standardRequest);
+  if (!level) {
+    return body;
+  }
+
+  const kwargs = levels[level];
+  if (!isEffortKwargsRecord(kwargs)) {
+    return body;
+  }
+
+  return {
+    ...body,
+    chat_template_kwargs: mergeEffortKwargs(kwargs, body.chat_template_kwargs)
+  };
+}
+
+export function deriveEffortKwargsLevel(
+  standardRequest: StandardRequest
+): EffortKwargsLevel | undefined {
+  const thinkingType = readEffortKwargsThinkingType(standardRequest.thinking);
+  if (thinkingType === 'disabled') {
+    return 'disabled';
+  }
+
+  const effort = normalizeEffortKwargsEffort(
+    readEffortKwargsNestedValue(standardRequest.output_config, 'effort')
+  );
+  if (effort) {
+    return effort;
+  }
+
+  if (thinkingType === 'enabled') {
+    const budget = readEffortKwargsNestedValue(standardRequest.thinking, 'budget_tokens');
+    if (typeof budget === 'number' && Number.isFinite(budget)) {
+      if (budget < EFFORT_KWARGS_BUDGET_LOW_MAX) {
+        return 'low';
+      }
+      if (budget < EFFORT_KWARGS_BUDGET_MEDIUM_MAX) {
+        return 'medium';
+      }
+      return 'high';
+    }
+  }
+
+  return undefined;
+}
+
+function readEffortKwargsForModel(
+  config: ProviderEffortKwargsConfig | undefined,
+  model: string | undefined
+): Record<string, unknown> | undefined {
+  const key = model?.trim();
+  if (!key || !isEffortKwargsRecord(config)) {
+    return undefined;
+  }
+
+  const direct = config[key];
+  if (isEffortKwargsRecord(direct)) {
+    return direct;
+  }
+
+  const normalized = key.toLowerCase();
+  for (const [candidate, levels] of Object.entries(config)) {
+    if (candidate.trim().toLowerCase() === normalized && isEffortKwargsRecord(levels)) {
+      return levels;
+    }
+  }
+
+  return undefined;
+}
+
+function normalizeEffortKwargsEffort(value: unknown): EffortKwargsLevel | undefined {
+  if (typeof value !== 'string') {
+    return undefined;
+  }
+
+  const normalized = value.trim().toLowerCase();
+  if (normalized === 'low' || normalized === 'medium' || normalized === 'high') {
+    return normalized;
+  }
+  if (normalized === 'max' || normalized === 'xhigh') {
+    return 'high';
+  }
+  return undefined;
+}
+
+function readEffortKwargsThinkingType(value: unknown): 'enabled' | 'disabled' | undefined {
+  const type = readEffortKwargsNestedValue(value, 'type');
+  if (typeof type !== 'string') {
+    return undefined;
+  }
+
+  const normalized = type.trim().toLowerCase();
+  if (normalized === 'enabled' || normalized === 'disabled') {
+    return normalized;
+  }
+  return undefined;
+}
+
+function readEffortKwargsNestedValue(value: unknown, key: string): unknown {
+  return isEffortKwargsRecord(value) ? value[key] : undefined;
+}
+
+/** Deep merge, with `existing` (already on the body) winning over the configured kwargs. */
+function mergeEffortKwargs(configured: Record<string, unknown>, existing: unknown): Record<string, unknown> {
+  if (!isEffortKwargsRecord(existing)) {
+    return { ...configured };
+  }
+
+  const merged: Record<string, unknown> = { ...configured };
+  for (const [key, value] of Object.entries(existing)) {
+    const base = merged[key];
+    merged[key] =
+      isEffortKwargsRecord(base) && isEffortKwargsRecord(value) ? mergeEffortKwargs(base, value) : value;
+  }
+
+  return merged;
+}
+
+function isEffortKwargsRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
