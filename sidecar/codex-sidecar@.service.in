[Unit]
Description=codex-sidecar generation %i (Anthropic Messages front end for codex personas)
# One generation per install run: %i is the activation id, %i's directory under
# generations/ holds the binary and the pinned files it reads. The listen sockets belong to
# the socket units; a generation inherits them (Sockets=) and never binds itself.
# SIGUSR1 retires a generation (stop admitting, finish in-flight requests, exit 0; exit 3
# when the retire deadline cut streams). install.sh runs every start, retire and switch.
# No After= line on purpose. `network.target` is LoadState=not-found in the systemd *user*
# manager (it orders against nothing), and a user unit cannot order after a system unit such
# as docker.service. A generation binds nothing: its only listener is codex-sidecar.socket
# (loopback; the docker0 listener retired with the router container). Do not re-add an
# ordering line.
@FLEET_ENV_UNIT@

[Service]
Type=notify
NotifyAccess=main
# Keep O_NONBLOCK on the inherited sockets: systemd rewrites the flag at every start of a unit
# that receives them, and the older generation shares the open file description (the default
# would make its accept blocking until this generation set the flag again).
NonBlocking=yes
Sockets=codex-sidecar.socket
ExecStart=@LIB_DIR@/generations/%i/codex-sidecar
Environment=PATH=@PATH@
Environment=SIDECAR_PERSONAS=@PERSONAS@
EnvironmentFile=@ENV_FILE@
Environment=SIDECAR_ACTIVATION=%i
StandardInput=null
Restart=on-failure
RestartSec=5
# Exit 3 is a retire that hit its deadline: a finished generation, never restarted.
RestartPreventExitStatus=3

# Hardening: networked baseline sandbox block; relaxations are commented inline.
# Writes: the persona CODEX_HOMEs (children refresh OAuth, sqlite, logs) and the sidecar
# log/state dirs. Reads %t/fleet-env (EnvironmentFile) and ~/.local/lib/codex (codex release).
# MemoryDenyWriteExecute is omitted on purpose: the codex children are unmeasured for a JIT.
# PrivateTmp is kept; the sidecar and its children use no shared /tmp state.
# codex bwrap sandbox (codex-cli 0.166; turns run "sandbox": "read-only" and unified_exec is
# catalog-pinned on) needs: user+mnt+pid+ipc+net namespaces, @mount + seccomp + capset/pivot_root
# (so ~@privileged is narrowed to its non-bwrap members), and AF_NETLINK (bwrap loopback setup).
# Measured 2026-11-02 with `codex sandbox -- /bin/echo ok` under these exact properties.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@RW_PATHS@ %h/.local/state/codex-sidecar
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=user mnt pid ipc net
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service @mount seccomp
SystemCallFilter=~@resources @clock @cpu-emulation @debug @module @obsolete @raw-io @reboot @swap bpf chroot setuid setresuid setgroups
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=default.target
