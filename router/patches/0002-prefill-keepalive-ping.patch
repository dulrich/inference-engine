+/**
+ * How long the local leg's converted Anthropic stream may stay byte-silent — from stream
+ * open through stream end, covering prefill and any mid-stream stall alike — before
+ * `relayConvertedStreamFromUpstreamResponse` injects a `ping` frame of its own. A module
+ * constant, not a config knob: comfortably inside Claude Code's 300 s read-timeout watchdog
+ * on `ANTHROPIC_BASE_URL` streams, and the traffic cost of a 15 s cadence is negligible.
+ */
+const LOCAL_LEG_IDLE_KEEP_ALIVE_INTERVAL_MS = 15_000;
+
+/**
+ * The `ping` frame for the local leg's idle-gap keepalive (see `withIdleGapKeepAlive` below).
+ * Deliberately NOT `optimisticStreamKeepAliveFrame` (above): that helper only emits `event:
+ * ping` once `relay.state.started` (i.e. after `message_start`) and degrades to an SSE
+ * comment before that — by design, for its post-start virtual-tool use, which stays
+ * byte-untouched. The idle-gap wrapper can fire before the upstream has sent anything at
+ * all (the whole point — it covers prefill), so it needs a frame that is safe to emit
+ * unconditionally. Measured tolerated pre-`message_start` by Claude Code 2.1.243 (see
+ * plans/router-prefill-keepalive-and-protocol-gaps.md); the byte shape is otherwise
+ * identical to the post-start helper's.
+ */
+export function preStartSafeAnthropicPingFrame(): string {
+  return encodeSseEvent('ping', { type: 'ping' });
+}
+
+/**
+ * Wrap `inner` so that any gap of `intervalMs` or more between frames it produces —
+ * including the gap before its first frame — yields one `pingFrame()` in the meantime,
+ * repeating for as long as the gap persists. Inner frames are forwarded in order and
+ * byte-identical; the wrapper never reorders, delays, or drops them. Once `inner` finishes
+ * (returns or throws), no further frames — including no trailing ping — are produced.
+ *
+ * Lives locally rather than reusing `keepAliveWhilePending` (`gateway/handler.ts`): that
+ * helper races a single pending promise against a repeating timer (built for one internal
+ * tool call), not repeated gaps across an entire stream's lifetime, and importing it here
+ * would create a module cycle — `handler.ts` already imports this module. This wrapper
+ * follows the same promise-race shape locally instead.
+ */
+export async function* withIdleGapKeepAlive(
+  inner: AsyncGenerator<string>,
+  pingFrame: () => string,
+  intervalMs: number
+): AsyncGenerator<string> {
+  let pendingNext = inner.next();
+  try {
+    for (;;) {
+      let timer: ReturnType<typeof setTimeout> | undefined;
+      let race: { timedOut: true } | { timedOut: false; result: IteratorResult<string> };
+      try {
+        // Cleared the instant the race settles, win or lose — not deferred until this
+        // iteration's `yield` is resumed, which the consumer (a Node `Readable`) controls
+        // and may not do for an arbitrary time. A settled-but-uncleared timer would sit
+        // there, formally still scheduled, for as long as the consumer takes to ask for
+        // the next frame.
+        race = await Promise.race([
+          pendingNext.then((result) => ({ timedOut: false as const, result })),
+          new Promise<{ timedOut: true }>((resolve) => {
+            timer = setTimeout(() => resolve({ timedOut: true }), intervalMs);
+          })
+        ]);
+      } finally {
+        clearTimeout(timer);
+      }
+
+      if (race.timedOut) {
+        yield pingFrame();
+        continue;
+      }
+
+      if (race.result.done) {
+        return;
+      }
+
+      yield race.result.value;
+      pendingNext = inner.next();
+    }
+  } finally {
+    try {
+      await inner.return?.(undefined);
+    } catch {
+      // Best-effort: inner is being torn down (abort/error unwind); nothing else to do
+      // with a failure to close it here.
+    }
+  }
+}
+
 export function canRelayOptimisticOpenAIChatStream(source: GatewaySourceContext): boolean {
   return source.adapterKey === 'openai_responses' || source.adapterKey === 'anthropic_messages';
 }
